{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Asia/Singapore",
  "schedule": [
    "before 9am on the first day of the month"
  ],
  "minimumReleaseAge": "14 days",
  "prConcurrentLimit": 2,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "GitHub Actions 合成一个 PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "补丁版本（如 1.2.3 → 1.2.4）：CI 全部通过后自动合并；小版本、大版本仍然等人看",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "小版本、补丁等 CI 全部通过后自动合并；大版本单独提 PR，等人确认后再合并",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "非大版本的升级全部合成一个 PR：每个 PR 都要跑一次 CI，合在一起最省 Actions 分钟",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch"
    }
  ]
}
